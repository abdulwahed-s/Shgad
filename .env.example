# Copy to the repository-root .env and fill locally. Never commit .env.
# Development backend/live checks load it; process variables take precedence.
# Blank optional values use defaults. Exact model IDs are separate from API keys.
LLM_PROVIDER=
LLM_MODEL_ID=
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL_ID=
LLM_TIMEOUT_SECONDS=10
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional, development comparison only (--provider openai).
OPENAI_API_KEY=
BUSINESS_AS_OF=
DATABASE_URL=sqlite:///./shgad.db
APP_ENV=development
# Evaluation only: absolute path to the sealed held-out file outside the repo
HELDOUT_PATH=
