# Copy to the repository-root .env and fill locally. Never commit .env.
# Development backend/live checks load it; process variables take precedence.
# Blank optional values use defaults. Exact model IDs are separate from API keys.
LLM_PROVIDER=gemini
LLM_MODEL_ID=gemini-3.8-flash
LLM_FALLBACK_PROVIDER=openai
LLM_FALLBACK_MODEL_ID=gpt-6-luna
LLM_TIMEOUT_SECONDS=30
# Primary total deadline (5–30); a timeout goes directly to fallback.
LLM_PRIMARY_TIMEOUT_SECONDS=15
# low sends the supported Gemini hint; default omits it for an explicit comparison.
GEMINI_REASONING_EFFORT=low
LLM_MAX_OUTPUT_TOKENS=8192
GEMINI_API_KEY=
# Paid OpenAI fallback; keep both provider credentials local.
OPENAI_API_KEY=
# Optional Groq development comparison credentials.
GROQ_API_KEY=
# Optional, NVIDIA-hosted development comparisons only.
BUILD_NVIDIA_API_KEY=
BUSINESS_AS_OF=
DATABASE_URL=sqlite:///./shgad.db
APP_ENV=development
# Evaluation only: absolute path to the sealed held-out file outside the repo
HELDOUT_PATH=
